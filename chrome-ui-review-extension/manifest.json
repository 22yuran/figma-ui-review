{
  "manifest_version": 3,
  "name": "Figma 一键 UI 走查",
  "version": "3.18.2",
  "description": "Jev 自动配对组件与测量对象，程序采集并测量文字、颜色、圆角与间距。",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "downloads",
    "webNavigation"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_title": "Figma 一键 UI 走查",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
